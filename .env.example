# =============================================================================
# AI Family Media Bot — environment configuration
# Copy to `.env` and adjust. Every value below has a safe local-dev default,
# so the stub runs end-to-end with NO AWS and NO Telegram token.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# all   = web tier + in-process worker (default; required for the in-memory queue)
# web   = serve HTTP only (prod web tier — pairs with SQS)
# worker= run the queue consumer only (prod worker tier — pairs with SQS)
RUN_MODE=all
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
WORKER_CONCURRENCY=1

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# json (default, structured) | console (human-readable for local dev)
LOG_FORMAT=json

# --- Swap points (interfaces) ------------------------------------------------
# Queue:   inmemory (dev, single process) | sqs (requires SQS_QUEUE_URL + AWS creds)
QUEUE=inmemory
SQS_QUEUE_URL=
# Story:   fake (canned bedtime story) | bedrock (Claude via Bedrock, AWS creds)
STORY_PROVIDER=fake
# Image:   fake (placeholder PNG)      | bedrock (Stability via Bedrock, AWS creds)
IMAGE_PROVIDER=fake
# Storage: local (writes to LOCAL_STORAGE_DIR) | s3 (requires S3_BUCKET)
STORAGE=local
LOCAL_STORAGE_DIR=./var/media
# Vision (family photo -> text character card): empty = follow STORY_PROVIDER.
#   fake | bedrock (Claude vision via Converse, same text model)
VISION_PROVIDER=
# Chat profiles (language choice + family story cast): empty = follow STORAGE.
#   local (LOCAL_STORAGE_DIR/profiles/) | s3 (profiles/<chat_id>.json, no expiry)
PROFILE_STORE=

# --- Telegram ----------------------------------------------------------------
# Leave the token blank for local dev: the worker logs "would send" instead of
# calling the Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# If set, /webhook requires a matching X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# true = pull updates via getUpdates long polling (local demo, no webhook).
# Run only ONE polling instance per bot token.
TELEGRAM_POLLING=false

# --- OpenTelemetry -----------------------------------------------------------
# Standard OTLP base endpoint (e.g. http://localhost:4318). Leave blank to make
# tracing a safe no-op. The HTTP exporter appends /v1/traces per OTel convention.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=family-media-bot

# --- AWS / Bedrock / S3 -------------------------------------------------------
# Credentials come from the standard AWS chain (env vars / default profile).
AWS_REGION=us-east-1
S3_BUCKET=
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Nova Canvas is Legacy-blocked on Bedrock; Stability Image Core is the active
# text-to-image model and (as of 2026-07) lives only in us-west-2.
BEDROCK_IMAGE_MODEL_ID=stability.stable-image-core-v1:1
BEDROCK_IMAGE_REGION=us-west-2

# --- Story shaping -----------------------------------------------------------
STORY_MAX_WORDS=220
