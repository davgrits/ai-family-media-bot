# =============================================================================
# AI Family Media Bot — environment configuration
# Copy to `.env` and adjust. Every value below has a safe local-dev default,
# so the app runs end-to-end with NO cloud account and NO Telegram token.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# all   = web tier + in-process worker (default; required for the in-memory queue)
# web   = serve HTTP only (prod web tier — pairs with Pub/Sub)
# worker= run the queue consumer only (prod worker tier — pairs with Pub/Sub)
RUN_MODE=all
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
WORKER_CONCURRENCY=1

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# json (default, structured) | console (human-readable for local dev)
LOG_FORMAT=json

# --- Swap points (interfaces) ------------------------------------------------
# Each port has a local fake and a GCP adapter. Note these are validated: an
# unrecognised value fails at startup rather than being ignored.
# Queue:   inmemory (dev) | pubsub
QUEUE=inmemory
# Story:   fake | vertex
STORY_PROVIDER=fake
# Image:   fake | vertex
IMAGE_PROVIDER=fake
# Storage: local | gcs
STORAGE=local
LOCAL_STORAGE_DIR=./var/media

# --- Telegram ----------------------------------------------------------------
# Leave the token blank for local dev: the worker logs "would send" instead of
# calling the Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# If set, /webhook requires a matching X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# true = pull updates via getUpdates long polling (local demo, no webhook).
# Run only ONE polling instance per bot token.
TELEGRAM_POLLING=false

# --- OpenTelemetry -----------------------------------------------------------
# Standard OTLP base endpoint (e.g. http://localhost:4318). Leave blank to make
# tracing a safe no-op. The HTTP exporter appends /v1/traces per OTel convention.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=family-media-bot

# --- GCP / Vertex AI / GCS / Pub/Sub ----------------------------------------
# Credentials come from ADC locally or GKE Workload Identity in the cluster.
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_BUCKET=
PUBSUB_TOPIC_NAME=
PUBSUB_SUBSCRIPTION_NAME=
VERTEX_TEXT_LOCATION=global
VERTEX_IMAGE_LOCATION=us-central1
VERTEX_TEXT_MODEL_ID=gemini-3.5-flash
VERTEX_IMAGE_MODEL_ID=gemini-2.5-flash-image

# --- Character registry ------------------------------------------------------
# Path to the story cast. `make run` and `make demo` set this for you; in the
# cluster it is a ConfigMap mount. Leave blank to run with no characters.
CHARACTERS_FILE=
# true = an absent registry is fatal at startup. Production sets this; local
# runs and the kind smoke test leave it false, since they mount no registry.
CHARACTERS_REQUIRED=false

# --- Story shaping -----------------------------------------------------------
STORY_MAX_WORDS=220
