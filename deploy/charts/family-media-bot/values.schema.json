{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "family-media-bot values",
  "description": "Validated at install/upgrade time. The point of this schema is to turn a misconfigured release into a helm error rather than a CrashLoopBackOff.",
  "type": "object",
  "required": ["image", "app", "serviceAccount", "gcp", "web", "worker"],
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Full Artifact Registry path, without a tag."
        },
        "tag": {
          "type": "string",
          "description": "Supplied by CI at upgrade time, not committed. Empty in values.yaml on purpose."
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "app": {
      "type": "object",
      "required": ["name", "telegramSecretName", "adapters"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "telegramSecretName": {
          "type": "string",
          "minLength": 1,
          "description": "Kubernetes Secret holding TELEGRAM_BOT_TOKEN. The token itself is never a value in this chart."
        },
        "workerConcurrency": { "type": "integer", "minimum": 1 },
        "logLevel": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        },
        "logFormat": { "type": "string", "enum": ["json", "console"] },
        "adapters": {
          "type": "object",
          "required": ["queue", "storage", "story", "image"],
          "additionalProperties": false,
          "description": "Mirrors the Literal types in app/family_media_bot/config.py. A value the app would reject at startup is rejected here instead.",
          "properties": {
            "queue": { "type": "string", "enum": ["inmemory", "pubsub"] },
            "storage": { "type": "string", "enum": ["local", "gcs"] },
            "story": { "type": "string", "enum": ["fake", "vertex"] },
            "image": { "type": "string", "enum": ["fake", "vertex"] }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "description": "Carries iam.gke.io/gcp-service-account for Workload Identity.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "gcp": {
      "type": "object",
      "required": [
        "projectId",
        "region",
        "mediaBucket",
        "jobsTopic",
        "jobsSubscription",
        "vertexTextModel",
        "vertexImageModel"
      ],
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "mediaBucket": { "type": "string", "minLength": 1 },
        "jobsTopic": { "type": "string", "minLength": 1 },
        "jobsSubscription": { "type": "string", "minLength": 1 },
        "vertexTextLocation": { "type": "string", "minLength": 1 },
        "vertexImageLocation": { "type": "string", "minLength": 1 },
        "vertexTextModel": {
          "type": "string",
          "minLength": 1,
          "description": "Must have a price entry in story_vertex.py, or the adapter refuses to start rather than reporting $0 per job."
        },
        "vertexImageModel": {
          "type": "string",
          "minLength": 1,
          "description": "Must have a price entry in image_vertex.py, for the same reason."
        }
      }
    },
    "web": {
      "type": "object",
      "required": ["replicaCount"],
      "additionalProperties": false,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    },
    "worker": {
      "type": "object",
      "required": ["replicaCount"],
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum 1 on purpose: activating from zero on Pub/Sub backlog measured ~4m43s, because the backlog metric samples on a ~60s interval."
        },
        "resources": { "type": "object" }
      }
    }
  }
}
